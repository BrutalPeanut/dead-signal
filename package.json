{
  "name": "dead-signal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "vite-node scripts/balance.ts",
    "progression": "vite-node scripts/progression.ts",
    "weapons": "vite-node scripts/weapons.ts",
    "builds": "vite-node scripts/melee.ts",
    "pacing": "vite-node scripts/pacing.ts",
    "ascension": "vite-node scripts/ascension.ts",
    "stats": "node scripts/stats.mjs",
    "build:crazygames": "tsc --noEmit && VITE_PORTAL=crazygames vite build && node scripts/portal-zip.mjs crazygames",
    "build:android": "tsc --noEmit && VITE_NATIVE=android vite build && cap sync android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.170.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capgo/native-purchases": "^8.9.8",
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0",
    "three": "^0.170.0"
  }
}
