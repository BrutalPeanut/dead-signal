# Used by .github/workflows/ios.yml on a GitHub Mac. Signs and uploads the iPhone app to TestFlight
# with the App Store Connect API key, no Mac or registered iPhone needed on our side:
# creates a throwaway Apple Distribution certificate + App Store profile, builds, uploads, then
# revokes the certificate so they never pile up (builds already uploaded are unaffected).
default_platform(:ios)

platform :ios do
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_filepath: ENV.fetch('ASC_KEY_PATH')
    )
    keychain = File.expand_path('~/Library/Keychains/ci-signing-db')
    create_keychain(name: 'ci-signing', password: 'ci', default_keychain: true, unlock: true, timeout: 3600)
    cert_id = nil
    begin
      cert(api_key: api_key, keychain_path: keychain, keychain_password: 'ci', output_path: ENV.fetch('RUNNER_TEMP'))
      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
      sigh(api_key: api_key, app_identifier: 'info.deadsignal.game', force: true, output_path: ENV.fetch('RUNNER_TEMP'))
      profile = lane_context[SharedValues::SIGH_NAME]
      update_code_signing_settings(
        path: 'App.xcodeproj', targets: ['App'], use_automatic_signing: false,
        team_id: ENV.fetch('APPLE_TEAM_ID'), code_sign_identity: 'Apple Distribution',
        profile_name: profile, bundle_identifier: 'info.deadsignal.game'
      )
      build_app(
        project: 'App.xcodeproj', scheme: 'App', configuration: 'Release',
        export_method: 'app-store',
        export_options: { provisioningProfiles: { 'info.deadsignal.game' => profile } },
        xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')} MARKETING_VERSION=#{ENV.fetch('MARKETING_VERSION')}",
        output_directory: ENV.fetch('RUNNER_TEMP')
      )
      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
    ensure
      if cert_id
        begin
          Spaceship::ConnectAPI::Certificate.get(certificate_id: cert_id).delete!
          UI.message("Revoked temporary certificate #{cert_id}")
        rescue => e
          UI.important("Could not revoke certificate #{cert_id}: #{e}")
        end
      end
    end
  end
end
